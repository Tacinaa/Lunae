EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google Calendar Import (OAuth2 PKCE, clients publics — pas de client secret)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-android.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-ios.apps.googleusercontent.com

# Sentry (suivi des erreurs applicatives — cf. docs/MAINTENANCE.md section 1.2)
# Laisser vide en local : le SDK reste inactif tant que cette variable n'est pas définie
# (voir App.tsx). DSN frontend récupéré depuis Sentry > Project Settings > Client Keys.
EXPO_PUBLIC_SENTRY_DSN=
